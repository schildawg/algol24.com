/// The generator for algol24.com.
///
/// Written in Algol-24 and compiled by algc, which is the point: the language
/// builds its own front door the way the compiler already builds itself.
///
/// Two pages: the home page from templates/index.html, and the language
/// reference read out of the pinned spec/ALGOL-24.md by gen/Markdown.a24 and
/// coloured by gen/Highlight.a24, whose keywords come from the pinned scanner.
/// So the rules the reference states and the words it colours both describe the
/// compiler that generated the page.
uses Template;
uses Markup;
uses Markdown;
uses Highlight;
uses '../vendor/algol24-library/strings';

/// ⚠️ The release number WITHOUT its leading 'v', because the page needs it
/// both ways: 'v0.2.7' in the hero, and 'algvm 0.2.7' where the install section
/// quotes what --version actually prints. One constant, and the template adds
/// the 'v' where it wants one.
///
/// ⚠️ TWO numbers now, and they are independent on purpose. The compiler and
/// the machine share one -- v0.2.2 made them read one constant, because a
/// version in two places is two answers to one question -- but the library
/// versions itself, being a USER of the language rather than part of it. The
/// hero shows both rather than implying one.
const Release := '0.2.7';
const Library := '0.1.0';
const Tap     := 'schildawg/algol24';
/// ⚠️ Repo, not Source. 'uses' brings a unit's names in unqualified, and
/// Highlight already has a Source -- the function that highlights a line. The
/// interpreter merely warned about the clash; the C back end emitted a
/// reference to the function where the constant belonged and would not compile.
/// A name here has to be one no imported unit uses.
const Repo := 'https://github.com/schildawg/algol24';

/// ⚠️ Read at build time, and pinned. This is the submodule's copy, so the
/// figure counted from it describes the same compiler the rest of the page
/// describes.
const Spec := 'vendor/algol24/spec/ALGOL-24.md';

/// ⚠️ The parts every page shares, kept in one copy each.
///
/// The reference needs the same palette, the same masthead and the same theme
/// switch as the home page, and a second copy of any of them is a second thing
/// to keep in step. They are substituted in rather than repeated.
const Boot  := 'templates/boot.html';
const Style := 'templates/site.css';
const Mast  := 'templates/masthead.html';
const Theme := 'templates/theme.html';

/// The reference is built from the pinned specification and the pinned
/// scanner: the rules it states and the keywords it colours both come from the
/// compiler this page describes.
///
/// ⚠️ ONE template for all three documents. They want the same chrome, the
/// same contents list and the same pre-paint script; only the title, the
/// description and the canonical URL differ, and those are placeholders.
const Doc     := 'templates/doc.html';
const Scanner := 'vendor/algol24/compiler/Scanner.a24';

/// The other two documents, each from the pin of the thing it documents.
///
/// ⚠️ The library is a SECOND submodule, pinned to its own release, because
/// its version is its own: v0.1.0 against the compiler's v0.2.3. Rendering it
/// from a pin is what stops the page describing a library nobody can install.
const OpRef  := 'vendor/algol24/vm/REFERENCE.md';
const LibRef := 'vendor/algol24-library/REFERENCE.md';

/// The number of rules in the specification, counted rather than written down.
///
/// ⚠️ Derived on purpose. The figure went 280 -> 281 -> 283 inside a fortnight
/// while three copies of it sat in prose here and in the compiler repository,
/// which answered by deleting its copies outright. A rule is introduced as
/// **[XXX-000]** at the start of a line; one line of prose opens '**[' while
/// citing two rules mid-sentence, which is why ']**' has to be there too.
///
/// ⚠️ Number 000 is RESERVED in every namespace and is never a real rule. It
/// is the format illustration in §1.3 -- [SRC-000], "An example rule" -- and it
/// is written exactly like the real ones, so counting lines alone counts it.
/// This said 283 at v0.1.2 when the specification held 282, and nothing
/// disagreed until v0.1.3 brought spec/spec.sh, which excludes 000 and is the
/// authority. Skipping it here is what makes the two agree.
function RuleCount () : String;
var
    Lines := List();
    N     := 0;

begin
    Lines := ReadLines(Spec);

    for var L in Lines do
        if StartsWith(L, '**[') and Pos(L, ']**', 0) >= 0
           and Pos(L, '-000]**', 0) < 0 then
            N := N + 1;

    Exit Str(N);
end

/// The number of opcodes, counted rather than written down.
///
/// ⚠️ THREE SOURCES DISAGREED, AND TWO OF THEM WERE WRONG. `vm/OpCode.a24`
/// declares 81 `const OP_`, but `OP_COUNT` is the sentinel that ends the set
/// and is not an instruction. The reference's own opening sentence says 78 --
/// in the one document whose stated discipline is that it never argues with
/// `OpCode.a24`. `OVERVIEW.md` says 80 and is right.
///
/// So this counts the entries in the document being rendered, which is the
/// only figure that cannot drift from the page the reader is looking at: one
/// '## OP_' heading per opcode, and the prefixes `OP_LONG` names in prose do
/// not get one.
function OpcodeCount () : String;
var
    N := 0;

begin
    for var L in ReadLines(OpRef) do
        if StartsWith(L, '## OP_') then N := N + 1;

    Exit Str(N);
end

/// Counted once, though it is cheap now that the walk reads lines directly.
var Rules   := '';
var Opcodes := '';

/// Makes a directory, and does not mind one that is already there.
///
/// ⚠️ MkDir raises when the directory exists -- 'MkDir failed: cannot create'
/// -- and there is no built-in that asks whether one does. The build runs more
/// than once against the same tree, so the second run would fail on what the
/// first run made, and catching is the only way to say "either way".
procedure EnsureDir (Name : String);
begin
    try
        MkDir(Name);
    except on X : String do
        // Already there, which is the ordinary case from the second build on.
        // A handler needs a statement, and this is the smallest honest one.
        X := X;
    end
end

/// Fills the parts every page shares.
function Shared (Page : String) : String;
begin
    Page := Replace(Page, '{{BOOT}}',     ReadFile(Boot));
    Page := Replace(Page, '{{STYLE}}',    ReadFile(Style));
    Page := Replace(Page, '{{MASTHEAD}}', ReadFile(Mast));
    Page := Replace(Page, '{{THEME}}',    ReadFile(Theme));
    Page := Replace(Page, '{{SOURCE}}',   Repo);
    Page := Replace(Page, '{{RULES}}',    Rules);

    Exit Page;
end

/// Writes one rendered document, chrome and all.
procedure WriteDoc (Dir : String, Into : String, Title : String,
                    Desc : String, Url : String, Toc : String, Body : String);
var
    Page := '';

begin
    EnsureDir(Dir);

    Page := Shared(ReadFile(Doc));
    Page := Replace(Page, '{{TITLE}}', Title);
    Page := Replace(Page, '{{DESC}}',  Desc);
    Page := Replace(Page, '{{URL}}',   Url);
    Page := Replace(Page, '{{TOC}}',   Toc);
    Page := Replace(Page, '{{BODY}}',  Body);

    WriteFile(Into, Page);

    WriteLn('  ' + Into);
end

/// Renders the specification into the reference page.
///
/// ⚠️ The ONE document that declares the rules it cites, so its citations are
/// same-page anchors: the link base stays empty here and is set for the other
/// two. Chapters at h2, sections at h3.
procedure RenderReference ();
var
    Lines := List();
    Words := Map();

begin
    Lines := ReadLines(Spec);
    Words := Keywords(ReadLines(Scanner));

    LinkRulesTo('');

    WriteDoc('site/reference', 'site/reference/index.html',
             'Algol-24 — Reference',
             'The Algol-24 language reference: ' + Rules +
             ' numbered rules, each claimed by a case that runs interpreted and compiled.',
             'https://algol24.com/reference/',
             ContentsOf(Lines, 2, 3),
             RenderUsing(Lines, Targets(Lines), Words));
end

/// Renders the bytecode reference into the opcodes page.
///
/// ⚠️ A LEVEL SHALLOWER than the specification: 19 groups at h1 over one entry
/// per opcode at h2. Read as h2-and-h3 it would list every mnemonic flat and
/// drop all 19 group names without a word about it.
///
/// ⚠️ It cites 65 rules it does not contain, so the citing targets come from
/// the pinned SPECIFICATION and point at the page that has them. A citation of
/// a rule the spec does not declare stays plain text rather than becoming a
/// link to nothing -- which is also how a bad citation shows up.
procedure RenderOpcodes ();
var
    Lines := List();
    Words := Map();

begin
    Lines := ReadLines(OpRef);
    Words := Keywords(ReadLines(Scanner));

    LinkRulesTo('/reference/');

    WriteDoc('site/opcodes', 'site/opcodes/index.html',
             'Algol-24 — Opcodes',
             'The Algol-24 bytecode reference: ' + Opcodes +
             ' opcodes, one entry each, every encoding checked against the machine.',
             'https://algol24.com/opcodes/',
             ContentsOf(Lines, 1, 2),
             RenderUsing(Lines, RuleTargets(ReadLines(Spec)), Words));
end

/// Renders the library reference into the library page.
///
/// ⚠️ NO GROUPS AT ALL -- 154 entries at h2, alphabetically, which is what a
/// reference after Turbo Pascal's own looks like. Its 850 Markdown links are
/// the reason this reader learned the syntax.
procedure RenderLibrary ();
var
    Lines := List();
    Words := Map();

begin
    Lines := ReadLines(LibRef);
    Words := Keywords(ReadLines(Scanner));

    LinkRulesTo('/reference/');

    WriteDoc('site/library', 'site/library/index.html',
             'Algol-24 — Library',
             'The Algol-24 library reference: ten units, every routine and constant, and every example run.',
             'https://algol24.com/library/',
             ContentsOf(Lines, 2, 3),
             RenderUsing(Lines, RuleTargets(ReadLines(Spec)), Words));
end

/// Renders one template into one output file.
procedure RenderPage (From : String, Into : String);
var
    Page : String;

begin
    Page := ReadFile(From);

    Page := Shared(Page);

    Page := Replace(Page, '{{RELEASE}}', Release);
    Page := Replace(Page, '{{LIBRARY}}', Library);
    Page := Replace(Page, '{{OPCODES}}', Opcodes);
    Page := Replace(Page, '{{TAP}}',     Tap);

    WriteFile(Into, Page);

    WriteLn('  ' + Into);
end

begin
    Rules   := RuleCount();
    Opcodes := OpcodeCount();

    WriteLn('generating:');

    RenderPage('templates/index.html', 'site/index.html');
    RenderReference();
    RenderOpcodes();
    RenderLibrary();

    WriteLn('done.');
end
