/// Markdown to HTML, as much of it as the specification actually uses.
///
/// This pass understands headings, paragraphs, fenced code, indented code,
/// inline code spans and emphasis, and it links a cited case to the place the
/// document writes that case out in full. Tables, block quotes and rules are
/// not here yet and appear as the characters that spell them.
///
/// The specification has no links in it at all -- no inline, no reference, no
/// autolinks -- so there is nothing here to read them with.
///
/// Everything works a line at a time, deliberately. A character index into a
/// string holding any non-ASCII character walks from the start to find its
/// byte offset, so reaching into a whole 352 KB document is quadratic while
/// reaching into one short line is not. Read with Template.ReadLines and the
/// question never comes up.
unit Markdown;

uses Strings;
uses Highlight;

/// The number of '#' a line opens with, or zero when it is not a heading.
///
/// A run of '#' is only a heading when a space follows it, which is what keeps
/// a line of hashes and a comment like '###' from becoming one.
function HeadingLevel (Line : String) : Integer;
var
    N := 0;

begin
    while (N < Length(Line)) and (Line[N] = '#') do
        N := N + 1;

    if N = 0 then Exit 0;
    if N >= Length(Line) then Exit 0;
    if Line[N] <> ' ' then Exit 0;

    Exit N;
end

/// The opening tags for a fenced block, naming its language when it has one.
///
/// The specification fences with 'algol' and 'console' and nothing else. The
/// class is the hook the syntax highlighter will want.
function OpenFence (Line : String) : String;
var
    Lang := '';

begin
    Lang := Trim(Copy(Line, 3, Length(Line) - 3));

    if Lang = '' then Exit '<pre><code>';

    // ⚠️ A console block is the case being RUN, and there are exactly as many
    // of them as there are cases. It gets a neutral bar rather than a starred
    // one: the eclipse colour belongs to the case's name, and two coloured bars
    // in a row would claim the two blocks are the same kind of thing.
    if Lang = 'console' then
        Exit '<p class="shell">Shell</p><pre><code class="language-console">';

    Exit '<pre><code class="language-' + Lang + '">';
end

/// The identifier for the place a case is written out.
///
/// A path is not a usable fragment as it stands, so the two characters that
/// separate its parts become the one that does not need escaping.
function Anchor (Path : String) : String;
begin
    Exit Replace(Replace(Path, '/', '-'), '.', '-');
end

/// Every case the document includes, mapped from its path to its anchor.
///
/// A '#####' heading naming conformance/… or refusals/… is where a case is
/// written out in full, and a rule that only cites one by name can then point
/// at it. This is the whole reason the reference is a single page: the target
/// is always in the same document, so nothing has to be resolved across files.
function Targets (Lines : List) : Map;
var
    Found := Map();

begin
    for var Raw in Lines do
        if HeadingLevel(Raw) = 5 then
        begin
            var Path := Trim(Copy(Raw, 5, Length(Raw) - 5));

            if StartsWith(Path, 'conformance/') or StartsWith(Path, 'refusals/') then
                Found.Put(Path, Anchor(Path));
        end

    // ⚠️ Rule identifiers share the map with case paths. The two cannot
    // collide -- one is 'XXX-000' and the other holds a '/' -- and one map
    // spares every function below a second parameter it would only pass on.
    for var Raw in Lines do
    begin
        var Id := RuleId(Raw);

        if Id <> '' then Found.Put(Id, Id);
    end

    Exit Found;
end

/// The path a citation names, or '' when the line does not carry one.
///
/// A citation is an indented line whose kind fills a thirteen-column field and
/// whose name begins at column seventeen; the specification aligns all 225 of
/// them exactly so. Only 'conformance' and 'refusal' name something this
/// document contains: 'unit' names a test in the compiler's own sources and
/// 'defect' one in DEFECTS.md, and neither can be pointed at from here.
///
/// The citing kind is singular and the directory is plural, so 'refusal' has to
/// be spelled back to 'refusals/' to match the heading it belongs to.
function CitedPath (Body : String) : String;
var
    Kind := '';
    Name := '';

begin
    if Length(Body) <= 13 then Exit '';

    Kind := Trim(Copy(Body, 0, 13));
    Name := Trim(Copy(Body, 13, Length(Body) - 13));

    if Name = '' then Exit '';
    if Pos(Name, ' ', 0) >= 0 then Exit '';

    if Kind = 'conformance' then Exit 'conformance/' + Name;
    if Kind = 'refusal' then Exit 'refusals/' + Name;

    Exit '';
end

/// A heading's identifier, made from its own text.
///
/// Letters and digits are kept and folded down; everything else becomes a
/// separator, and runs of separators collapse. '## 4. Lexical elements' answers
/// '4-lexical-elements'.
///
/// The numbers are what keep these apart. Two chapters could otherwise share a
/// slug, and the specification numbers all of its chapters and sections.
function Slug (Text : String) : String;
var
    B    := Buffer();
    Gap  := False;
    Seen := False;

begin
    for var I : Integer := 0; I < Length(Text); I := I + 1 do
    begin
        var O := Ord(Text[I]);
        var Keep := ((O >= 97) and (O <= 122)) or ((O >= 48) and (O <= 57));

        if (O >= 65) and (O <= 90) then
        begin
            O    := O + 32;
            Keep := True;
        end

        if Keep then
        begin
            if Gap and Seen then B.Append('-');

            B.Append(Char(O));

            Gap  := False;
            Seen := True;
        end
        else Gap := True;
    end

    Exit B.Text;
end

/// The rule a line defines, or '' when it defines none.
///
/// A rule opens its paragraph as `**[XXX-000]**`. One line of prose opens '**['
/// while citing two rules mid-sentence, and the ']**' is what tells them apart.
function RuleId (Line : String) : String;
var
    Shut := 0;

begin
    if not StartsWith(Line, '**[') then Exit '';

    Shut := Pos(Line, ']**', 0);

    if Shut < 0 then Exit '';

    Exit Copy(Line, 3, Shut - 3);
end

/// Every `[XXX-000]` that names a rule this document defines, made a link.
///
/// Membership does the validating. A bracketed group is linked when the map
/// holds it and left alone when it does not, so `[I]` in a subscript and
/// `[ERROR]` in output need no rule of their own to be spared.
///
/// The rule's own paragraph links to itself, which is deliberate: the bold
/// identifier at the head of a rule is the thing a reader wants the address of.
function LinkRules (Text : String, Refs : Map) : String;
var
    B     := Buffer();
    Start := 0;
    At    := 0;

begin
    At := Pos(Text, '[', 0);

    while At >= 0 do
    begin
        var Shut := Pos(Text, ']', At + 1);
        var Id   := '';

        if Shut >= 0 then Id := Copy(Text, At + 1, Shut - At - 1);

        if (Id <> '') and Refs.Contains(Id) then
        begin
            B.Append(Copy(Text, Start, At - Start));
            B.Append('<a class="rule" href="#' + Id + '">[' + Id + ']</a>');

            Start := Shut + 1;
            At    := Pos(Text, '[', Start);
        end
        else At := Pos(Text, '[', At + 1);
    end

    B.Append(Copy(Text, Start, Length(Text) - Start));

    Exit B.Text;
end

/// Whether a line is a citation, whatever it happens to cite.
///
/// CitedPath answers only for the kinds this document can point AT. A block is
/// still a block of citations when its lines name a unit test or a defect, and
/// deciding how to draw the block is a different question from whether each
/// line can be linked.
function IsCitation (Body : String) : Boolean;
var
    Kind := '';

begin
    if Length(Body) <= 13 then Exit False;

    Kind := Trim(Copy(Body, 0, 13));

    if Trim(Copy(Body, 13, Length(Body) - 13)) = '' then Exit False;

    Exit (Kind = 'conformance') or (Kind = 'refusal')
      or (Kind = 'unit') or (Kind = 'defect');
end

/// An indented block, drawn as citations or as code.
///
/// The two arrive as the same Markdown, and the document holds 225 lines of the
/// first against 489 of the second, so telling them apart is worth the trouble:
/// a citation is apparatus and a sample is content, and dressing them alike
/// makes the reader sort them out for themselves. A block counts as citations
/// when every line in it that is not blank is one.
function Indent (Code : List, Cases : Map) : String;
var
    B     := Buffer();
    Cites := True;
    Any   := False;
    First := True;

begin
    for var L in Code do
        if Trim(L) <> '' then
        begin
            Any := True;

            if not IsCitation(L) then Cites := False;
        end

    Cites := Any and Cites;

    if Cites then B.Append('<div class="cites">');
    else B.Append('<pre><code>');

    for var L in Code do
    begin
        // ⚠️ A div with white-space: pre shows a trailing newline where a pre
        // swallows it, so the separator goes BETWEEN lines rather than after.
        if not First then B.Append(#10);

        First := False;

        var Path := CitedPath(L);

        if (Path <> '') and Cases.Contains(Path) then
        begin
            B.Append(Escape(Copy(L, 0, 13)));
            B.Append('<a href="#' + Cases.Get(Path) + '">');
            B.Append(Escape(Trim(Copy(L, 13, Length(L) - 13))));
            B.Append('</a>');
        end
        else B.Append(Escape(L));
    end

    if Cites then B.Append('</div>' + #10);
    else B.Append(#10 + '</code></pre>' + #10);

    Exit B.Text;
end

/// Every pair of Mark in Text wrapped in Open and Close.
///
/// A mark with no partner after it is left as the character it is, rather than
/// opening an element that never closes. That is what keeps a lone asterisk in
/// running prose from swallowing the rest of the line.
function Wrap (Text : String, Mark : String, Open : String, Close : String) : String;
var
    B     := Buffer();
    Start := 0;
    Step  := 0;
    A     := 0;
    Z     := 0;

begin
    Step := Length(Mark);
    A    := Pos(Text, Mark, 0);

    while A >= 0 do
    begin
        Z := Pos(Text, Mark, A + Step);

        if Z < 0 then A := -1;
        else
        begin
            B.Append(Copy(Text, Start, A - Start));
            B.Append(Open);
            B.Append(Copy(Text, A + Step, Z - A - Step));
            B.Append(Close);

            Start := Z + Step;
            A     := Pos(Text, Mark, Start);
        end
    end

    B.Append(Copy(Text, Start, Length(Text) - Start));

    Exit B.Text;
end

/// Bold and italic, in that order.
///
/// The double mark has to be taken first. Run singly first and the opening two
/// asterisks of a bold run become an empty italic, and the text after it never
/// recovers.
///
/// An underscore is not emphasis here, deliberately. The grammar annex is written
/// in snake_case, so 'hex_lit = decimal_digit' would italicise from its first
/// underscore to its last and take the production with it.
function Emphasis (Text : String) : String;
begin
    Exit Wrap(Wrap(Text, '**', '<strong>', '</strong>'), '*', '<em>', '</em>');
end

/// One line of inline Markdown as HTML.
///
/// Three phases, and the middle one is why. Emphasis has to see the line whole,
/// because a bold run may contain a code span -- the specification writes
/// things like "so **a `//` comment in a file** …" throughout. Applying
/// emphasis to each stretch between backticks separately cuts such a run in
/// half, and its two markers then pair with whatever else is nearby: one line
/// came out as '</strong>dispatch<em></em>'. So every span is lifted out first
/// and a marker left in its place, emphasis runs over the whole line, and the
/// spans go back afterwards.
///
/// The marker is #1, and it is #1 rather than #0 for a reason worth keeping.
/// A String holds a zero byte happily and Length counts it, but Pos does not
/// see one: searching for Char(0) answers 0 against any text at all, the same
/// answer it gives for an empty part. The marker would have been found in every
/// line, including the ones with no code span in them. #1 searches correctly
/// and no text file this reads will contain either.
///
/// Escaping happens once, first, over the whole line, so the text inside a span
/// is escaped too. A line whose backticks do not pair has its last span closed
/// here rather than left for the browser to guess at.
function Inline (Text : String, Refs : Map) : String;
var
    Safe  := '';
    Spans := List();
    Held  := Buffer();
    Out   := Buffer();
    Start := 0;
    At    := 0;
    I     := 0;
    Open  := False;

begin
    Safe := Escape(Text);
    At   := Pos(Safe, '`', 0);

    while At >= 0 do
    begin
        var Seg := Copy(Safe, Start, At - Start);

        if Open then
        begin
            Spans.Add(Seg);
            Held.Append(Char(1));
        end
        else Held.Append(Seg);

        Open  := not Open;
        Start := At + 1;
        At    := Pos(Safe, '`', Start);
    end

    var Tail := Copy(Safe, Start, Length(Safe) - Start);

    if Open then
    begin
        Spans.Add(Tail);
        Held.Append(Char(1));
    end
    else Held.Append(Tail);

    var Marked := LinkRules(Emphasis(Held.Text), Refs);

    At := Pos(Marked, Char(1), 0);
    Start := 0;

    while At >= 0 do
    begin
        Out.Append(Copy(Marked, Start, At - Start));
        Out.Append('<code>' + Spans[I] + '</code>');

        I     := I + 1;
        Start := At + 1;
        At    := Pos(Marked, Char(1), Start);
    end

    Out.Append(Copy(Marked, Start, Length(Marked) - Start));

    Exit Out.Text;
end

/// Whether a line is a table's separator rather than a row of data.
///
/// A dash is what decides it. A row of empty cells is written '| | |' and is
/// nothing but pipes and spaces, and five of those appear in the document; a
/// separator always carries at least one dash.
function IsSeparator (Line : String) : Boolean;
var
    Seen := False;

begin
    for var I : Integer := 0; I < Length(Line); I := I + 1 do
    begin
        var C := Line[I];

        if C = '-' then Seen := True;
        else if (C <> '|') and (C <> ':') and (C <> ' ') then Exit False;
    end

    Exit Seen;
end

/// The cells of a table row, trimmed.
///
/// Every one of the document's 169 rows both opens and closes with a pipe, so
/// splitting on the pipe leaves an empty field at each end to drop.
function Cells (Line : String) : List;
var
    Out   := List();
    Inner := '';

begin
    Inner := Trim(Line);

    if Length(Inner) < 2 then Exit Out;

    Inner := Copy(Inner, 1, Length(Inner) - 2);

    for var C in Split(Inner, '|') do
        Out.Add(Trim(C));

    Exit Out;
end

/// What each column of a separator asks for, as a style attribute or nothing.
///
/// Two tables use ':-:' to centre, and one of them is a six-column matrix that
/// is genuinely hard to read ranged left.
function Aligns (Sep : String) : List;
var
    Out := List();

begin
    for var C in Cells(Sep) do
    begin
        var Left  := StartsWith(C, ':');
        var Right := (Length(C) > 0) and (C[Length(C) - 1] = ':');

        if Left and Right then Out.Add(' style="text-align:center"');
        else if Right then Out.Add(' style="text-align:right"');
        else Out.Add('');
    end

    Exit Out;
end

/// One row of a table, its cells in the given tag.
function Row (Line : String, Tag : String, Align : List, Refs : Map) : String;
var
    B := Buffer();
    I := 0;

begin
    B.Append('<tr>');

    for var C in Cells(Line) do
    begin
        var A := '';

        if I < Align.Length then A := Align[I];

        B.Append('<' + Tag + A + '>' + Inline(C, Refs) + '</' + Tag + '>');
        I := I + 1;
    end

    B.Append('</tr>');

    Exit B.Text;
end

/// A run of pipe rows as a table.
///
/// A run whose second line is not a separator has no header, and every row of
/// it is a body row. Nothing in this document is written that way, and the
/// alternative is dropping the first row on the floor.
function Table (Rows : List, Refs : Map) : String;
var
    B     := Buffer();
    Align := List();
    First := 0;

begin
    if (Rows.Length >= 2) and IsSeparator(Rows[1]) then
    begin
        Align := Aligns(Rows[1]);
        B.Append('<table><thead>' + Row(Rows[0], 'th', Align, Refs) + '</thead><tbody>');
        First := 2;
    end
    else B.Append('<table><tbody>');

    for var I : Integer := First; I < Rows.Length; I := I + 1 do
        B.Append(Row(Rows[I], 'td', Align, Refs));

    B.Append('</tbody></table>' + #10);

    Exit B.Text;
end

/// The lines of a block quote with the marker taken off.
///
/// One space after the marker is part of the marker; any further indent is the
/// quoted text's own.
function Unquote (Lines : List) : List;
var
    Out := List();

begin
    for var L in Lines do
    begin
        var Rest := Copy(L, 1, Length(L) - 1);

        if StartsWith(Rest, ' ') then Rest := Copy(Rest, 1, Length(Rest) - 1);

        Out.Add(Rest);
    end

    Exit Out;
end

/// A run of bullet items as a list.
function Bullets (Items : List, Refs : Map) : String;
var
    B := Buffer();

begin
    B.Append('<ul>');

    for var I in Items do
        B.Append('<li>' + Inline(I, Refs) + '</li>');

    B.Append('</ul>' + #10);

    Exit B.Text;
end

/// Whether a line is a horizontal rule.
///
/// Every one of the document's rules follows a blank line, so none of them is
/// the underline of a setext heading and all can be read as rules.
function IsRule (Line : String) : Boolean;
var
    T := '';

begin
    T := Trim(Line);

    if Length(T) < 3 then Exit False;

    for var I : Integer := 0; I < Length(T); I := I + 1 do
        if T[I] <> '-' then Exit False;

    Exit True;
end

/// The blocks of a Markdown document rendered as HTML.
///
/// A block is closed by what follows it rather than by anything of its own, so
/// there is one place that finishes whatever is open and a second at the end for
/// whatever the document left open. A blank line does not close an indented
/// block: the citation lists under a rule are one block with blank lines in them.
///
/// This takes the case map rather than building it, so that a block quote can
/// render its own contents down the same path without rebuilding the map or
/// losing the targets that live outside the quote.
///
/// A table row and a quote marker are only recognised in the first column. An
/// indented line is code, and a pipe inside code is a pipe.
function Blocks (Lines : List, Cases : Map, Words : Map) : String;
var
    Out     := Buffer();
    Para    := '';
    Rows    := List();
    Quote   := List();
    Items   := List();
    Item    := '';
    Code    := List();
    InFence := False;
    InCode  := False;
    Level   := 0;
    Lang    := '';

begin
    for var Raw in Lines do
    begin
        if InFence then
        begin
            if StartsWith(Raw, '```') then
            begin
                Out.Append('</code></pre>' + #10);
                InFence := False;
            end
            else if Lang = 'algol24' then Out.Append(Source(Raw, Words) + #10);
            else if Lang = 'console' then Out.Append(Console(Raw) + #10);
            else Out.Append(Escape(Raw) + #10);
        end
        else
        begin
            var Blank    := Trim(Raw) = '';
            var Indented := StartsWith(Raw, '    ') and (not Blank);
            var Fenced   := StartsWith(Raw, '```');
            var Tabled   := StartsWith(Raw, '|');
            var Quoted   := StartsWith(Raw, '>');
            var Ruled    := IsRule(Raw);
            var Bulleted := StartsWith(Raw, '- ');

            Level := HeadingLevel(Raw);

            // An item wraps onto lines indented by two spaces, which is why
            // they are not code: code wants four.
            var InList    := (Items.Length > 0) or (Item <> '');
            var Continues := InList and (not Blank) and (not Bulleted)
                           and (not Indented) and (not Fenced) and (not Tabled)
                           and (not Quoted) and (not Ruled) and (Level = 0);

            if InCode and (not Indented) and (not Blank) then
            begin
                Out.Append(Indent(Code, Cases));

                Code   := List();
                InCode := False;
            end

            if (Rows.Length > 0) and (not Tabled) then
            begin
                Out.Append(Table(Rows, Cases));
                Rows := List();
            end

            if InList and (not Bulleted) and (not Continues) then
            begin
                if Item <> '' then Items.Add(Item);

                Out.Append(Bullets(Items, Cases));

                Item  := '';
                Items := List();
            end

            if (Quote.Length > 0) and (not Quoted) then
            begin
                Out.Append('<blockquote>' + #10 + Blocks(Unquote(Quote), Cases, Words)
                         + '</blockquote>' + #10);
                Quote := List();
            end

            if Continues then Item := Item + ' ' + Trim(Raw);
            else if (not Blank) and (not Indented) and (not Fenced) and (not Tabled)
                                and (not Quoted) and (not Ruled) and (not Bulleted)
                                and (Level = 0) then
            begin
                if Para = '' then Para := Trim(Raw);
                else Para := Para + ' ' + Trim(Raw);
            end
            else
            begin
                if Para <> '' then
                begin
                    var Id := RuleId(Para);
                    var At := '';

                    if Id <> '' then At := ' id="' + Id + '"';

                    Out.Append('<p' + At + '>' + Inline(Para, Cases) + '</p>' + #10);
                    Para := '';
                end

                if Bulleted then
                begin
                    if Item <> '' then Items.Add(Item);

                    Item := Trim(Copy(Raw, 2, Length(Raw) - 2));
                end
                else if Tabled then Rows.Add(Raw);
                else if Quoted then Quote.Add(Raw);
                else if Ruled then Out.Append('<hr>' + #10);
                else if Fenced then
                begin
                    Out.Append(OpenFence(Raw));
                    Lang    := Trim(Copy(Raw, 3, Length(Raw) - 3));
                    InFence := True;
                end
                else if Level > 0 then
                begin
                    var Head := Trim(Copy(Raw, Level, Length(Raw) - Level));
                    var Id   := '';

                    // ⚠️ A class as well as an id. The case name is drawn as a
                    // caption on the block it names, and every one of the 239 is
                    // followed immediately by that block, so the join is done in
                    // CSS by adjacency rather than by wrapping anything here.
                    if Cases.Contains(Head) then
                        Id := ' class="case" id="' + Cases.Get(Head) + '"';
                    else if Level <= 3 then Id := ' id="' + Slug(Head) + '"';

                    Out.Append('<h' + Str(Level) + Id + '>' + Inline(Head, Cases)
                             + '</h' + Str(Level) + '>' + #10);
                end
                else if Indented then
                begin
                    InCode := True;

                    Code.Add(Copy(Raw, 4, Length(Raw) - 4));
                end
                else if Blank and InCode then Code.Add('');
            end
        end
    end

    if Para <> '' then
    begin
        var Id := RuleId(Para);
        var At := '';

        if Id <> '' then At := ' id="' + Id + '"';

        Out.Append('<p' + At + '>' + Inline(Para, Cases) + '</p>' + #10);
    end

    if Item <> '' then Items.Add(Item);
    if Items.Length > 0 then Out.Append(Bullets(Items, Cases));

    if Rows.Length > 0 then Out.Append(Table(Rows, Cases));

    if Quote.Length > 0 then
        Out.Append('<blockquote>' + #10 + Blocks(Unquote(Quote), Cases, Words)
                 + '</blockquote>' + #10);

    if InCode  then Out.Append(Indent(Code, Cases));
    if InFence then Out.Append('</code></pre>' + #10);

    Exit Out.Text;
end

/// The chapters and their sections, as a nested list of links.
///
/// h2 is a chapter and h3 a section. h1 is the document's title and h5 names a
/// case, and 239 case names do not belong in a table of contents.
///
/// ⚠️ The entries are rendered with an EMPTY reference map. A heading holding a
/// rule identifier would otherwise put a link inside a link, which is not
/// something HTML has an opinion about so much as a thing browsers each guess
/// at differently.
function Contents (Lines : List) : String;
var
    B       := Buffer();
    Chapter := False;
    Sub     := False;

begin
    B.Append('<nav class="toc" aria-label="Contents">' + #10 + '<ol>' + #10);

    for var Raw in Lines do
    begin
        var L := HeadingLevel(Raw);

        if (L = 2) or (L = 3) then
        begin
            var Head := Trim(Copy(Raw, L, Length(Raw) - L));
            var Link := '<a href="#' + Slug(Head) + '">' + Inline(Head, Map()) + '</a>';

            if L = 2 then
            begin
                if Sub then B.Append('</ol>' + #10);
                if Chapter then B.Append('</li>' + #10);

                B.Append('<li>' + Link);

                Chapter := True;
                Sub     := False;
            end
            else
            begin
                if not Sub then B.Append(#10 + '<ol>' + #10);

                B.Append('<li>' + Link + '</li>' + #10);

                Sub := True;
            end
        end
    end

    if Sub then B.Append('</ol>' + #10);
    if Chapter then B.Append('</li>' + #10);

    B.Append('</ol>' + #10 + '</nav>' + #10);

    Exit B.Text;
end

/// The lines of a Markdown document rendered as HTML, with source highlighted
/// against the given keyword table.
function RenderWith (Lines : List, Words : Map) : String;
begin
    Exit Blocks(Lines, Targets(Lines), Words);
end

/// The same, with nothing treated as a keyword.
///
/// The table is read from the compiler at build time, so the tests do without
/// it: what they check is the structure the reader produces, not the colour of
/// a word inside a fence.
function Render (Lines : List) : String;
begin
    Exit RenderWith(Lines, Map());
end

/// Renders one line, which is all most of these tests need.
function One (Line : String) : String;
var
    L := List();

begin
    L.Add(Line);

    Exit Render(L);
end

test 'HeadingLevel Counts Hashes And Requires A Space';
begin
    AssertEqual(1, HeadingLevel('# One'));
    AssertEqual(3, HeadingLevel('### Three'));
    AssertEqual(5, HeadingLevel('##### Five'));
    AssertEqual(0, HeadingLevel('###'));
    AssertEqual(0, HeadingLevel('#NoSpace'));
    AssertEqual(0, HeadingLevel('not a heading'));
end

test 'Render Makes A Heading At Its Level';
begin
    AssertEqual('<h2 id="notation">Notation</h2>' + #10, One('## Notation'));
end

test 'Render Joins The Lines Of A Paragraph';
begin
    var L := List();
    L.Add('one two');
    L.Add('three four');

    AssertEqual('<p>one two three four</p>' + #10, Render(L));
end

test 'Render Separates Paragraphs On A Blank Line';
begin
    var L := List();
    L.Add('first');
    L.Add('');
    L.Add('second');

    AssertEqual('<p>first</p>' + #10 + '<p>second</p>' + #10, Render(L));
end

test 'Render Turns Backticks Into Code Spans';
begin
    AssertEqual('<p>a <code>Pos</code> call</p>' + #10, One('a `Pos` call'));
end

test 'Render Escapes Inside A Code Span As Well As Outside';
begin
    AssertEqual('<p><code>a &lt; b</code></p>' + #10, One('`a < b`'));
end

/// An unpaired backtick would otherwise leave the element open.
test 'Render Closes A Code Span The Line Left Open';
begin
    AssertEqual('<p>an <code>open span</code></p>' + #10, One('an `open span'));
end

test 'Render Carries The Language Of A Fenced Block';
begin
    var L := List();
    L.Add('```algol');
    L.Add('begin');
    L.Add('```');

    AssertEqual('<pre><code class="language-algol">begin' + #10 + '</code></pre>' + #10,
                Render(L));
end

test 'Render Fences Without A Language Too';
begin
    var L := List();
    L.Add('```');
    L.Add('plain');
    L.Add('```');

    AssertEqual('<pre><code>plain' + #10 + '</code></pre>' + #10, Render(L));
end

/// Markdown inside a fence is text, not markup.
test 'Render Leaves A Fenced Block Alone';
begin
    var L := List();
    L.Add('```');
    L.Add('# not a heading and `not` a span');
    L.Add('```');

    AssertEqual('<pre><code># not a heading and `not` a span' + #10 + '</code></pre>' + #10,
                Render(L));
end

test 'Render Makes An Indented Block Into Code';
begin
    var L := List();
    L.Add('    WriteLn (1);');

    AssertEqual('<pre><code>WriteLn (1);' + #10 + '</code></pre>' + #10, Render(L));
end

/// Apparatus and content arrive as the same Markdown and are drawn apart.
test 'Render Draws A Block Of Only Citations As Citations';
begin
    var L := List();
    L.Add('    unit         Scan Operators');
    L.Add('    defect       DEF-34');

    AssertEqual('<div class="cites">unit         Scan Operators' + #10
              + 'defect       DEF-34</div>' + #10,
                Render(L));
end

/// One line of code in it and the whole block is a sample.
test 'Render Draws A Mixed Block As Code';
begin
    var L := List();
    L.Add('    unit         Scan Operators');
    L.Add('    WriteLn (1);');

    AssertEqual('<pre><code>unit         Scan Operators' + #10
              + 'WriteLn (1);' + #10 + '</code></pre>' + #10,
                Render(L));
end

/// The citation lists under a rule are one block with blank lines in them.
test 'Render Keeps An Indented Block Open Across A Blank Line';
begin
    var L := List();
    L.Add('    one');
    L.Add('');
    L.Add('    two');

    AssertEqual('<pre><code>one' + #10 + #10 + 'two' + #10 + '</code></pre>' + #10,
                Render(L));
end

test 'Render Closes An Indented Block When Prose Resumes';
begin
    var L := List();
    L.Add('    code');
    L.Add('prose');

    AssertEqual('<pre><code>code' + #10 + '</code></pre>' + #10 + '<p>prose</p>' + #10,
                Render(L));
end

test 'Render Closes A Paragraph Before A Heading';
begin
    var L := List();
    L.Add('text');
    L.Add('## After');

    AssertEqual('<p>text</p>' + #10 + '<h2 id="after">After</h2>' + #10, Render(L));
end

test 'Render Answers Nothing For Nothing';
begin
    AssertEqual('', Render(List()));
end

test 'Emphasis Reads Bold And Italic';
begin
    AssertEqual('<p><strong>bold</strong></p>' + #10, One('**bold**'));
    AssertEqual('<p><em>soft</em></p>' + #10, One('*soft*'));
end

/// Taken the other way round, the two opening asterisks become an empty italic.
///
/// The line also DEFINES the rule it opens with, so the paragraph takes its id
/// and the identifier links to itself.
test 'Emphasis Takes The Double Mark Before The Single';
begin
    AssertEqual('<p id="RT-005"><strong>'
              + '<a class="rule" href="#RT-005">[RT-005]</a></strong> holds</p>' + #10,
                One('**[RT-005]** holds'));
end

/// The identifier at the head of a rule is what a reader wants the address of.
test 'Render Anchors A Rule On Its Own Paragraph';
begin
    var L := List();
    L.Add('**[LEX-018]** An Integer is unbounded.');
    L.Add('');
    L.Add('See [LEX-018] for the reason.');

    AssertEqual('<p id="LEX-018"><strong>'
              + '<a class="rule" href="#LEX-018">[LEX-018]</a></strong> '
              + 'An Integer is unbounded.</p>' + #10
              + '<p>See <a class="rule" href="#LEX-018">[LEX-018]</a> for the reason.</p>' + #10,
                Render(L));
end

/// Membership does the validating, so nothing else needs sparing by hand.
test 'Render Leaves A Bracket That Names No Rule Alone';
begin
    AssertEqual('<p>See [LEX-018] for the reason.</p>' + #10,
                One('See [LEX-018] for the reason.'));
    AssertEqual('<p>a[I] and [ERROR]</p>' + #10, One('a[I] and [ERROR]'));
end

/// A glob or a footnote marker in prose must survive.
test 'Emphasis Leaves An Unpaired Mark As Text';
begin
    AssertEqual('<p>a * b</p>' + #10, One('a * b'));
end

/// The grammar annex is snake_case throughout.
test 'Emphasis Never Reads An Underscore';
begin
    AssertEqual('<p>hex_lit = decimal_digit</p>' + #10, One('hex_lit = decimal_digit'));
end

test 'Emphasis Does Not Reach Inside A Code Span';
begin
    AssertEqual('<p><code>a ** b</code></p>' + #10, One('`a ** b`'));
end

test 'Anchor Turns A Case Path Into A Fragment';
begin
    AssertEqual('conformance-0089-text-builtins-a24', Anchor('conformance/0089-text-builtins.a24'));
end

test 'CitedPath Reads The Kinds This Document Can Point At';
begin
    AssertEqual('conformance/0089.a24', CitedPath('conformance  0089.a24'));
    AssertEqual('refusals/0174.a24',    CitedPath('refusal      0174.a24'));
end

/// A unit test lives in the compiler's sources and a defect in DEFECTS.md.
test 'CitedPath Declines The Kinds That Live Elsewhere';
begin
    AssertEqual('', CitedPath('unit         Scan A Whole Program'));
    AssertEqual('', CitedPath('defect       DEF-34'));
    AssertEqual('', CitedPath('function Foo () : Integer;'));
end

test 'Render Gives An Included Case Heading An Anchor';
begin
    AssertEqual('<h5 class="case" id="conformance-0051-a24">conformance/0051.a24</h5>' + #10,
                One('##### conformance/0051.a24'));
end

test 'Render Links A Citation To The Case It Names';
begin
    var L := List();
    L.Add('##### conformance/0089.a24');
    L.Add('');
    L.Add('    conformance  0089.a24');

    AssertEqual('<h5 class="case" id="conformance-0089-a24">conformance/0089.a24</h5>' + #10
              + '<div class="cites">conformance  '
              + '<a href="#conformance-0089-a24">0089.a24</a></div>' + #10,
                Render(L));
end

/// 'TBD' is a placeholder, and there is nothing to point at.
test 'Render Leaves A Citation Alone When The Case Is Not Included';
begin
    var L := List();
    L.Add('    conformance  TBD');

    AssertEqual('<div class="cites">conformance  TBD</div>' + #10, Render(L));
end

test 'IsSeparator Needs A Dash, Not Merely Pipes';
begin
    AssertTrue(IsSeparator('| --- | --- |'));
    AssertTrue(IsSeparator('| --- | :-: |'));
    AssertTrue(not IsSeparator('| | |'));
    AssertTrue(not IsSeparator('| a | b |'));
end

test 'Cells Drops The Pipe At Either End And Trims';
begin
    var C := Cells('| a |  b  |');

    AssertEqual(2, C.Length);
    AssertEqual(Str('a'), C[0]);
    AssertEqual(Str('b'), C[1]);
end

test 'Cells Keeps An Empty Cell';
begin
    var C := Cells('| | x |');

    AssertEqual(2, C.Length);
    AssertEqual('', C[0]);
end

test 'Render Builds A Table With A Head And A Body';
begin
    var L := List();
    L.Add('| Name | Rule |');
    L.Add('| --- | --- |');
    L.Add('| `Pos` | [RT-005] |');

    AssertEqual('<table><thead><tr><th>Name</th><th>Rule</th></tr></thead><tbody>'
              + '<tr><td><code>Pos</code></td><td>[RT-005]</td></tr>'
              + '</tbody></table>' + #10,
                Render(L));
end

test 'Render Centres A Column The Separator Marks';
begin
    var L := List();
    L.Add('| a | b |');
    L.Add('| --- | :-: |');
    L.Add('| 1 | 2 |');

    AssertEqual('<table><thead><tr><th>a</th><th style="text-align:center">b</th></tr>'
              + '</thead><tbody><tr><td>1</td>'
              + '<td style="text-align:center">2</td></tr></tbody></table>' + #10,
                Render(L));
end

test 'Render Closes A Table When The Rows Stop';
begin
    var L := List();
    L.Add('| a |');
    L.Add('| --- |');
    L.Add('| 1 |');
    L.Add('after');

    AssertEqual('<table><thead><tr><th>a</th></tr></thead><tbody><tr><td>1</td></tr>'
              + '</tbody></table>' + #10 + '<p>after</p>' + #10,
                Render(L));
end

test 'Render Quotes A Block And Reads Markdown Inside It';
begin
    var L := List();
    L.Add('> **bold** and `code`');

    AssertEqual('<blockquote>' + #10
              + '<p><strong>bold</strong> and <code>code</code></p>' + #10
              + '</blockquote>' + #10,
                Render(L));
end

test 'Render Joins The Lines Of A Quoted Paragraph';
begin
    var L := List();
    L.Add('> one');
    L.Add('> two');
    L.Add('after');

    AssertEqual('<blockquote>' + #10 + '<p>one two</p>' + #10 + '</blockquote>' + #10
              + '<p>after</p>' + #10,
                Render(L));
end

test 'Render Makes A Horizontal Rule';
begin
    AssertEqual('<hr>' + #10, One('---'));
    AssertEqual('<hr>' + #10, One('-----'));
end

/// A pipe inside an indented block is a pipe, not a table.
test 'Render Does Not Read A Table Out Of Indented Code';
begin
    AssertEqual('<pre><code>| not | a table |' + #10 + '</code></pre>' + #10,
                One('    | not | a table |'));
end

test 'Render Makes A List Of Bullet Items';
begin
    var L := List();
    L.Add('- one');
    L.Add('- two');

    AssertEqual('<ul><li>one</li><li>two</li></ul>' + #10, Render(L));
end

/// An item wraps onto lines indented by two spaces, which is why they are not
/// code: code wants four.
test 'Render Joins An Item With Its Continuation Line';
begin
    var L := List();
    L.Add('- Arms compare with `=`, so a Double matches an');
    L.Add('  Integer arm of the same value.');

    AssertEqual('<ul><li>Arms compare with <code>=</code>, so a Double matches an '
              + 'Integer arm of the same value.</li></ul>' + #10,
                Render(L));
end

test 'Render Closes A List When The Prose Resumes';
begin
    var L := List();
    L.Add('- item');
    L.Add('');
    L.Add('after');

    AssertEqual('<ul><li>item</li></ul>' + #10 + '<p>after</p>' + #10, Render(L));
end

test 'Render Reads Markdown Inside An Item';
begin
    AssertEqual('<ul><li><strong>bold</strong> item</li></ul>' + #10, One('- **bold** item'));
end

/// The console block is the case being run, and is labelled as Zig labels its.
test 'Render Labels A Console Block';
begin
    var L := List();
    L.Add('```console');
    L.Add('$ algc x.a24');
    L.Add('```');

    AssertEqual('<p class="shell">Shell</p><pre><code class="language-console">$ algc x.a24'
              + #10 + '</code></pre>' + #10,
                Render(L));
end

/// A dash that opens no item is prose.
test 'Render Does Not Read A Bare Dash As A Bullet';
begin
    AssertEqual('<p>-not a bullet</p>' + #10, One('-not a bullet'));
end

test 'Slug Folds A Heading Down To An Identifier';
begin
    AssertEqual('4-lexical-elements', Slug('4. Lexical elements'));
    AssertEqual('annex-a-grammar-summary-non-normative',
                Slug('Annex A — grammar summary *(non-normative)*'));
end

/// Runs of punctuation collapse, and the ends carry none.
test 'Slug Collapses Separators And Trims Them';
begin
    AssertEqual('a-b', Slug('  a --- b!!  '));
    AssertEqual('', Slug('--- ...'));
end

test 'Render Gives A Chapter And A Section An Anchor';
begin
    AssertEqual('<h2 id="4-lexical-elements">4. Lexical elements</h2>' + #10,
                One('## 4. Lexical elements'));
    AssertEqual('<h3 id="4-1-comments">4.1 Comments</h3>' + #10, One('### 4.1 Comments'));
end

/// A case caption keeps the anchor its citations point at.
test 'Render Does Not Slug A Case Caption';
begin
    var L := List();
    L.Add('##### conformance/0089.a24');

    AssertEqual('<h5 class="case" id="conformance-0089-a24">conformance/0089.a24</h5>' + #10,
                Render(L));
end

test 'Contents Nests Sections Under Their Chapter';
begin
    var L := List();
    L.Add('## 4. Lexical elements');
    L.Add('### 4.1 Comments');
    L.Add('### 4.2 Tokens');
    L.Add('## 5. Types');

    AssertEqual('<nav class="toc" aria-label="Contents">' + #10 + '<ol>' + #10
              + '<li><a href="#4-lexical-elements">4. Lexical elements</a>' + #10
              + '<ol>' + #10
              + '<li><a href="#4-1-comments">4.1 Comments</a></li>' + #10
              + '<li><a href="#4-2-tokens">4.2 Tokens</a></li>' + #10
              + '</ol>' + #10 + '</li>' + #10
              + '<li><a href="#5-types">5. Types</a></li>' + #10
              + '</ol>' + #10 + '</nav>' + #10,
                Contents(L));
end

/// A case name is a heading and is not contents.
test 'Contents Ignores The Title And The Case Names';
begin
    var L := List();
    L.Add('# Algol-24');
    L.Add('##### conformance/0089.a24');

    AssertEqual('<nav class="toc" aria-label="Contents">' + #10 + '<ol>' + #10
              + '</ol>' + #10 + '</nav>' + #10,
                Contents(L));
end
