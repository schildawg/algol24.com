/// Reading and writing the text of a page.
///
/// This is the whole of the generator's contact with the filesystem, and it is
/// deliberately small: everything above it works on Strings. Substitution used
/// to live here as a hand-rolled quadratic loop, and moved to the Strings unit
/// as one linear pass the day v0.1.2 gave Pos a start index.
unit Template;

/// The whole of a file as one String, lines rejoined with #10.
///
/// A Buffer rather than repeated concatenation -- a page is tens of kilobytes
/// and '+' in a loop is the concatenation cliff this exists to answer.
function ReadFile (Name : String) : String;
var
    F     := TextFile();
    B     := Buffer();
    First := True;

begin
    F.Assign(Name);
    F.Reset();

    while not F.Eof do
    begin
        if not First then
            B.Append(Char(10));

        B.Append(F.ReadLn());

        First := False;
    end

    F.Close();

    Exit B.Text;
end

/// The lines of a file, in order, with no terminators.
///
/// ⚠️ Prefer this to ReadFile for anything large. A character index into a
/// string holding any non-ASCII character has to walk from the start to find
/// the byte offset, so taking twelve thousand of them into one 352 KB document
/// is quadratic: ReadFile followed by Split costs 3.40s on the specification,
/// and this costs 0.006s for the same twelve thousand lines. The document is
/// full of warning signs and em-dashes, so the ASCII fast path never applies.
function ReadLines (Name : String) : List;
var
    F     := TextFile();
    Lines := List();

begin
    F.Assign(Name);
    F.Reset();

    while not F.Eof do
        Lines.Add(F.ReadLn());

    F.Close();

    Exit Lines;
end

/// Writes Text to Name, replacing whatever was there.
///
/// ⚠️ The directory must already exist. The language cannot create one, so the
/// caller mkdirs first -- which is exactly the workaround that stops working
/// once the output tree is decided by the content rather than by the script.
procedure WriteFile (Name : String, Text : String);
var
    F := TextFile();

begin
    F.Assign(Name);
    F.Rewrite();

    /// ⚠️ WriteLn, not Write. ReadFile joins lines with #10 between them and
    /// never after the last, so writing with Write would drop the file's final
    /// newline and the output would differ from its input by one byte. In a
    /// project that requires its compiler to reproduce itself byte for byte,
    /// the site generator can manage the same.
    F.WriteLn(Text);

    F.Close();
end
