/// Markdown to HTML, as much of it as the specification actually uses.
///
/// This pass understands headings, paragraphs, fenced code, indented code,
/// inline code spans and emphasis, and it links a cited case to the place the
/// document writes that case out in full. Tables, block quotes and rules are
/// not here yet and appear as the characters that spell them.
///
/// The specification has no links in it at all -- no inline, no reference, no
/// autolinks -- so there is nothing here to read them with.
///
/// Everything works a line at a time, deliberately. A character index into a
/// string holding any non-ASCII character walks from the start to find its
/// byte offset, so reaching into a whole 352 KB document is quadratic while
/// reaching into one short line is not. Read with Template.ReadLines and the
/// question never comes up.
unit Markdown;

uses Strings;

/// Text with the three characters HTML reserves replaced by entities.
///
/// The ampersand is replaced first. Doing it last would rewrite the ampersands
/// that the other two had just introduced, and every entity on the page would
/// arrive doubly escaped.
function Escape (Text : String) : String;
var
    S := '';

begin
    S := Replace(Text, '&', '&amp;');
    S := Replace(S, '<', '&lt;');

    Exit Replace(S, '>', '&gt;');
end

/// The number of '#' a line opens with, or zero when it is not a heading.
///
/// A run of '#' is only a heading when a space follows it, which is what keeps
/// a line of hashes and a comment like '###' from becoming one.
function HeadingLevel (Line : String) : Integer;
var
    N := 0;

begin
    while (N < Length(Line)) and (Line[N] = '#') do
        N := N + 1;

    if N = 0 then Exit 0;
    if N >= Length(Line) then Exit 0;
    if Line[N] <> ' ' then Exit 0;

    Exit N;
end

/// The opening tags for a fenced block, naming its language when it has one.
///
/// The specification fences with 'algol' and 'console' and nothing else. The
/// class is the hook the syntax highlighter will want.
function OpenFence (Line : String) : String;
var
    Lang := '';

begin
    Lang := Trim(Copy(Line, 3, Length(Line) - 3));

    if Lang = '' then Exit '<pre><code>';

    Exit '<pre><code class="language-' + Lang + '">';
end

/// The identifier for the place a case is written out.
///
/// A path is not a usable fragment as it stands, so the two characters that
/// separate its parts become the one that does not need escaping.
function Anchor (Path : String) : String;
begin
    Exit Replace(Replace(Path, '/', '-'), '.', '-');
end

/// Every case the document includes, mapped from its path to its anchor.
///
/// A '#####' heading naming conformance/… or refusals/… is where a case is
/// written out in full, and a rule that only cites one by name can then point
/// at it. This is the whole reason the reference is a single page: the target
/// is always in the same document, so nothing has to be resolved across files.
function Targets (Lines : List) : Map;
var
    Found := Map();

begin
    for var Raw in Lines do
        if HeadingLevel(Raw) = 5 then
        begin
            var Path := Trim(Copy(Raw, 5, Length(Raw) - 5));

            if StartsWith(Path, 'conformance/') or StartsWith(Path, 'refusals/') then
                Found.Put(Path, Anchor(Path));
        end

    Exit Found;
end

/// The path a citation names, or '' when the line does not carry one.
///
/// A citation is an indented line whose kind fills a thirteen-column field and
/// whose name begins at column seventeen; the specification aligns all 225 of
/// them exactly so. Only 'conformance' and 'refusal' name something this
/// document contains: 'unit' names a test in the compiler's own sources and
/// 'defect' one in DEFECTS.md, and neither can be pointed at from here.
///
/// The citing kind is singular and the directory is plural, so 'refusal' has to
/// be spelled back to 'refusals/' to match the heading it belongs to.
function CitedPath (Body : String) : String;
var
    Kind := '';
    Name := '';

begin
    if Length(Body) <= 13 then Exit '';

    Kind := Trim(Copy(Body, 0, 13));
    Name := Trim(Copy(Body, 13, Length(Body) - 13));

    if Name = '' then Exit '';
    if Pos(Name, ' ', 0) >= 0 then Exit '';

    if Kind = 'conformance' then Exit 'conformance/' + Name;
    if Kind = 'refusal' then Exit 'refusals/' + Name;

    Exit '';
end

/// Every pair of Mark in Text wrapped in Open and Close.
///
/// A mark with no partner after it is left as the character it is, rather than
/// opening an element that never closes. That is what keeps a lone asterisk in
/// running prose from swallowing the rest of the line.
function Wrap (Text : String, Mark : String, Open : String, Close : String) : String;
var
    B     := Buffer();
    Start := 0;
    Step  := 0;
    A     := 0;
    Z     := 0;

begin
    Step := Length(Mark);
    A    := Pos(Text, Mark, 0);

    while A >= 0 do
    begin
        Z := Pos(Text, Mark, A + Step);

        if Z < 0 then A := -1;
        else
        begin
            B.Append(Copy(Text, Start, A - Start));
            B.Append(Open);
            B.Append(Copy(Text, A + Step, Z - A - Step));
            B.Append(Close);

            Start := Z + Step;
            A     := Pos(Text, Mark, Start);
        end
    end

    B.Append(Copy(Text, Start, Length(Text) - Start));

    Exit B.Text;
end

/// Bold and italic, in that order.
///
/// The double mark has to be taken first. Run singly first and the opening two
/// asterisks of a bold run become an empty italic, and the text after it never
/// recovers.
///
/// An underscore is not emphasis here, deliberately. The grammar annex is written
/// in snake_case, so 'hex_lit = decimal_digit' would italicise from its first
/// underscore to its last and take the production with it.
function Emphasis (Text : String) : String;
begin
    Exit Wrap(Wrap(Text, '**', '<strong>', '</strong>'), '*', '<em>', '</em>');
end

/// One line of inline Markdown as HTML.
///
/// Three phases, and the middle one is why. Emphasis has to see the line whole,
/// because a bold run may contain a code span -- the specification writes
/// things like "so **a `//` comment in a file** …" throughout. Applying
/// emphasis to each stretch between backticks separately cuts such a run in
/// half, and its two markers then pair with whatever else is nearby: one line
/// came out as '</strong>dispatch<em></em>'. So every span is lifted out first
/// and a marker left in its place, emphasis runs over the whole line, and the
/// spans go back afterwards.
///
/// The marker is #1, and it is #1 rather than #0 for a reason worth keeping.
/// A String holds a zero byte happily and Length counts it, but Pos does not
/// see one: searching for Char(0) answers 0 against any text at all, the same
/// answer it gives for an empty part. The marker would have been found in every
/// line, including the ones with no code span in them. #1 searches correctly
/// and no text file this reads will contain either.
///
/// Escaping happens once, first, over the whole line, so the text inside a span
/// is escaped too. A line whose backticks do not pair has its last span closed
/// here rather than left for the browser to guess at.
function Inline (Text : String) : String;
var
    Safe  := '';
    Spans := List();
    Held  := Buffer();
    Out   := Buffer();
    Start := 0;
    At    := 0;
    I     := 0;
    Open  := False;

begin
    Safe := Escape(Text);
    At   := Pos(Safe, '`', 0);

    while At >= 0 do
    begin
        var Seg := Copy(Safe, Start, At - Start);

        if Open then
        begin
            Spans.Add(Seg);
            Held.Append(Char(1));
        end
        else Held.Append(Seg);

        Open  := not Open;
        Start := At + 1;
        At    := Pos(Safe, '`', Start);
    end

    var Tail := Copy(Safe, Start, Length(Safe) - Start);

    if Open then
    begin
        Spans.Add(Tail);
        Held.Append(Char(1));
    end
    else Held.Append(Tail);

    var Marked := Emphasis(Held.Text);

    At := Pos(Marked, Char(1), 0);
    Start := 0;

    while At >= 0 do
    begin
        Out.Append(Copy(Marked, Start, At - Start));
        Out.Append('<code>' + Spans[I] + '</code>');

        I     := I + 1;
        Start := At + 1;
        At    := Pos(Marked, Char(1), Start);
    end

    Out.Append(Copy(Marked, Start, Length(Marked) - Start));

    Exit Out.Text;
end

/// The lines of a Markdown document rendered as HTML.
///
/// A block is closed by what follows it rather than by anything of its own, so
/// there is a single place where an open paragraph or an open indented block is
/// finished, and a second at the end for whatever the document left open. A
/// blank line does not close an indented block: a run of them separated by
/// blank lines is one block, which is what the citation lists under each rule
/// depend on.
function Render (Lines : List) : String;
var
    Out      := Buffer();
    Para     := '';
    InFence  := False;
    InCode   := False;
    Level    := 0;
    Cases    := Map();

begin
    Cases := Targets(Lines);

    for var Raw in Lines do
    begin
        if InFence then
        begin
            if StartsWith(Raw, '```') then
            begin
                Out.Append('</code></pre>' + #10);
                InFence := False;
            end
            else Out.Append(Escape(Raw) + #10);
        end
        else
        begin
            var Blank    := Trim(Raw) = '';
            var Indented := StartsWith(Raw, '    ') and (not Blank);
            var Fenced   := StartsWith(Raw, '```');

            Level := HeadingLevel(Raw);

            if InCode and (not Indented) and (not Blank) then
            begin
                Out.Append('</code></pre>' + #10);
                InCode := False;
            end

            if (not Blank) and (not Indented) and (not Fenced) and (Level = 0) then
            begin
                if Para = '' then Para := Trim(Raw);
                else Para := Para + ' ' + Trim(Raw);
            end
            else
            begin
                if Para <> '' then
                begin
                    Out.Append('<p>' + Inline(Para) + '</p>' + #10);
                    Para := '';
                end

                if Fenced then
                begin
                    Out.Append(OpenFence(Raw));
                    InFence := True;
                end
                else if Level > 0 then
                begin
                    var Head := Trim(Copy(Raw, Level, Length(Raw) - Level));
                    var Id   := '';

                    if Cases.Contains(Head) then Id := ' id="' + Cases.Get(Head) + '"';

                    Out.Append('<h' + Str(Level) + Id + '>' + Inline(Head)
                             + '</h' + Str(Level) + '>' + #10);
                end
                else if Indented then
                begin
                    if not InCode then
                    begin
                        Out.Append('<pre><code>');
                        InCode := True;
                    end

                    var Body := Copy(Raw, 4, Length(Raw) - 4);
                    var Path := CitedPath(Body);

                    // ⚠️ The kind field is emitted whole so the column keeps its
                    // alignment; only the name becomes the link.
                    if (Path <> '') and Cases.Contains(Path) then
                    begin
                        Out.Append(Escape(Copy(Body, 0, 13)));
                        Out.Append('<a href="#' + Cases.Get(Path) + '">');
                        Out.Append(Escape(Trim(Copy(Body, 13, Length(Body) - 13))));
                        Out.Append('</a>' + #10);
                    end
                    else Out.Append(Escape(Body) + #10);
                end
                else if Blank and InCode then Out.Append(#10);
            end
        end
    end

    if Para <> '' then Out.Append('<p>' + Inline(Para) + '</p>' + #10);
    if InCode  then Out.Append('</code></pre>' + #10);
    if InFence then Out.Append('</code></pre>' + #10);

    Exit Out.Text;
end

/// Renders one line, which is all most of these tests need.
function One (Line : String) : String;
var
    L := List();

begin
    L.Add(Line);

    Exit Render(L);
end

test 'Escape Replaces The Three Reserved Characters';
begin
    AssertEqual('&lt;pre&gt;', Escape('<pre>'));
    AssertEqual('&amp;amp;', Escape('&amp;'));
end

test 'HeadingLevel Counts Hashes And Requires A Space';
begin
    AssertEqual(1, HeadingLevel('# One'));
    AssertEqual(3, HeadingLevel('### Three'));
    AssertEqual(5, HeadingLevel('##### Five'));
    AssertEqual(0, HeadingLevel('###'));
    AssertEqual(0, HeadingLevel('#NoSpace'));
    AssertEqual(0, HeadingLevel('not a heading'));
end

test 'Render Makes A Heading At Its Level';
begin
    AssertEqual('<h2>Notation</h2>' + #10, One('## Notation'));
end

test 'Render Joins The Lines Of A Paragraph';
begin
    var L := List();
    L.Add('one two');
    L.Add('three four');

    AssertEqual('<p>one two three four</p>' + #10, Render(L));
end

test 'Render Separates Paragraphs On A Blank Line';
begin
    var L := List();
    L.Add('first');
    L.Add('');
    L.Add('second');

    AssertEqual('<p>first</p>' + #10 + '<p>second</p>' + #10, Render(L));
end

test 'Render Turns Backticks Into Code Spans';
begin
    AssertEqual('<p>a <code>Pos</code> call</p>' + #10, One('a `Pos` call'));
end

test 'Render Escapes Inside A Code Span As Well As Outside';
begin
    AssertEqual('<p><code>a &lt; b</code></p>' + #10, One('`a < b`'));
end

/// An unpaired backtick would otherwise leave the element open.
test 'Render Closes A Code Span The Line Left Open';
begin
    AssertEqual('<p>an <code>open span</code></p>' + #10, One('an `open span'));
end

test 'Render Carries The Language Of A Fenced Block';
begin
    var L := List();
    L.Add('```algol');
    L.Add('begin');
    L.Add('```');

    AssertEqual('<pre><code class="language-algol">begin' + #10 + '</code></pre>' + #10,
                Render(L));
end

test 'Render Fences Without A Language Too';
begin
    var L := List();
    L.Add('```');
    L.Add('plain');
    L.Add('```');

    AssertEqual('<pre><code>plain' + #10 + '</code></pre>' + #10, Render(L));
end

/// Markdown inside a fence is text, not markup.
test 'Render Leaves A Fenced Block Alone';
begin
    var L := List();
    L.Add('```');
    L.Add('# not a heading and `not` a span');
    L.Add('```');

    AssertEqual('<pre><code># not a heading and `not` a span' + #10 + '</code></pre>' + #10,
                Render(L));
end

test 'Render Makes An Indented Block Into Code';
begin
    var L := List();
    L.Add('    conformance  0089.a24');

    AssertEqual('<pre><code>conformance  0089.a24' + #10 + '</code></pre>' + #10, Render(L));
end

/// The citation lists under a rule are one block with blank lines in them.
test 'Render Keeps An Indented Block Open Across A Blank Line';
begin
    var L := List();
    L.Add('    one');
    L.Add('');
    L.Add('    two');

    AssertEqual('<pre><code>one' + #10 + #10 + 'two' + #10 + '</code></pre>' + #10,
                Render(L));
end

test 'Render Closes An Indented Block When Prose Resumes';
begin
    var L := List();
    L.Add('    code');
    L.Add('prose');

    AssertEqual('<pre><code>code' + #10 + '</code></pre>' + #10 + '<p>prose</p>' + #10,
                Render(L));
end

test 'Render Closes A Paragraph Before A Heading';
begin
    var L := List();
    L.Add('text');
    L.Add('## After');

    AssertEqual('<p>text</p>' + #10 + '<h2>After</h2>' + #10, Render(L));
end

test 'Render Answers Nothing For Nothing';
begin
    AssertEqual('', Render(List()));
end

test 'Emphasis Reads Bold And Italic';
begin
    AssertEqual('<p><strong>bold</strong></p>' + #10, One('**bold**'));
    AssertEqual('<p><em>soft</em></p>' + #10, One('*soft*'));
end

/// Taken the other way round, the two opening asterisks become an empty italic.
test 'Emphasis Takes The Double Mark Before The Single';
begin
    AssertEqual('<p><strong>[RT-005]</strong> holds</p>' + #10, One('**[RT-005]** holds'));
end

/// A glob or a footnote marker in prose must survive.
test 'Emphasis Leaves An Unpaired Mark As Text';
begin
    AssertEqual('<p>a * b</p>' + #10, One('a * b'));
end

/// The grammar annex is snake_case throughout.
test 'Emphasis Never Reads An Underscore';
begin
    AssertEqual('<p>hex_lit = decimal_digit</p>' + #10, One('hex_lit = decimal_digit'));
end

test 'Emphasis Does Not Reach Inside A Code Span';
begin
    AssertEqual('<p><code>a ** b</code></p>' + #10, One('`a ** b`'));
end

test 'Anchor Turns A Case Path Into A Fragment';
begin
    AssertEqual('conformance-0089-text-builtins-a24', Anchor('conformance/0089-text-builtins.a24'));
end

test 'CitedPath Reads The Kinds This Document Can Point At';
begin
    AssertEqual('conformance/0089.a24', CitedPath('conformance  0089.a24'));
    AssertEqual('refusals/0174.a24',    CitedPath('refusal      0174.a24'));
end

/// A unit test lives in the compiler's sources and a defect in DEFECTS.md.
test 'CitedPath Declines The Kinds That Live Elsewhere';
begin
    AssertEqual('', CitedPath('unit         Scan A Whole Program'));
    AssertEqual('', CitedPath('defect       DEF-34'));
    AssertEqual('', CitedPath('function Foo () : Integer;'));
end

test 'Render Gives An Included Case Heading An Anchor';
begin
    AssertEqual('<h5 id="conformance-0051-a24">conformance/0051.a24</h5>' + #10,
                One('##### conformance/0051.a24'));
end

test 'Render Links A Citation To The Case It Names';
begin
    var L := List();
    L.Add('##### conformance/0089.a24');
    L.Add('');
    L.Add('    conformance  0089.a24');

    AssertEqual('<h5 id="conformance-0089-a24">conformance/0089.a24</h5>' + #10
              + '<pre><code>conformance  <a href="#conformance-0089-a24">0089.a24</a>' + #10
              + '</code></pre>' + #10,
                Render(L));
end

/// 'TBD' is a placeholder, and there is nothing to point at.
test 'Render Leaves A Citation Alone When The Case Is Not Included';
begin
    var L := List();
    L.Add('    conformance  TBD');

    AssertEqual('<pre><code>conformance  TBD' + #10 + '</code></pre>' + #10, Render(L));
end
