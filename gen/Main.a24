/// The generator for algol24.com.
///
/// Written in Algol-24 and compiled by algc, which is the point: the language
/// builds its own front door the way the compiler already builds itself.
///
/// Two pages: the home page from templates/index.html, and the language
/// reference read out of the pinned spec/ALGOL-24.md by gen/Markdown.a24 and
/// coloured by gen/Highlight.a24, whose keywords come from the pinned scanner.
/// So the rules the reference states and the words it colours both describe the
/// compiler that generated the page.
uses Template;
uses Strings;
uses Markdown;
uses Highlight;

/// ⚠️ The release number WITHOUT its leading 'v', because the page needs it
/// both ways: 'v0.1.4' in the hero, and 'algc 0.1.4' where the install section
/// quotes what --version actually prints. One constant, and the template adds
/// the 'v' where it wants one.
const Release := '0.1.4';
const Status  := 'pre-1.0';
const Tap     := 'schildawg/algol24';
/// ⚠️ Repo, not Source. 'uses' brings a unit's names in unqualified, and
/// Highlight already has a Source -- the function that highlights a line. The
/// interpreter merely warned about the clash; the C back end emitted a
/// reference to the function where the constant belonged and would not compile.
/// A name here has to be one no imported unit uses.
const Repo := 'https://github.com/schildawg/algol24';

/// ⚠️ Read at build time, and pinned. This is the submodule's copy, so the
/// figure counted from it describes the same compiler the rest of the page
/// describes.
const Spec := 'vendor/algol24/spec/ALGOL-24.md';

/// ⚠️ The parts every page shares, kept in one copy each.
///
/// The reference needs the same palette, the same masthead and the same theme
/// switch as the home page, and a second copy of any of them is a second thing
/// to keep in step. They are substituted in rather than repeated.
const Boot  := 'templates/boot.html';
const Style := 'templates/site.css';
const Mast  := 'templates/masthead.html';
const Theme := 'templates/theme.html';

/// The reference is built from the pinned specification and the pinned
/// scanner: the rules it states and the keywords it colours both come from the
/// compiler this page describes.
const Reference := 'templates/reference.html';
const RefInto   := 'site/reference/index.html';
const RefDir    := 'site/reference';
const Scanner   := 'vendor/algol24/compiler/Scanner.a24';

/// The number of rules in the specification, counted rather than written down.
///
/// ⚠️ Derived on purpose. The figure went 280 -> 281 -> 283 inside a fortnight
/// while three copies of it sat in prose here and in the compiler repository,
/// which answered by deleting its copies outright. A rule is introduced as
/// **[XXX-000]** at the start of a line; one line of prose opens '**[' while
/// citing two rules mid-sentence, which is why ']**' has to be there too.
///
/// ⚠️ Number 000 is RESERVED in every namespace and is never a real rule. It
/// is the format illustration in §1.3 -- [SRC-000], "An example rule" -- and it
/// is written exactly like the real ones, so counting lines alone counts it.
/// This said 283 at v0.1.2 when the specification held 282, and nothing
/// disagreed until v0.1.3 brought spec/spec.sh, which excludes 000 and is the
/// authority. Skipping it here is what makes the two agree.
function RuleCount () : String;
var
    Lines := List();
    N     := 0;

begin
    Lines := ReadLines(Spec);

    for var L in Lines do
        if StartsWith(L, '**[') and Pos(L, ']**', 0) >= 0
           and Pos(L, '-000]**', 0) < 0 then
            N := N + 1;

    Exit Str(N);
end

/// Counted once, though it is cheap now that the walk reads lines directly.
var Rules := '';

/// Makes a directory, and does not mind one that is already there.
///
/// ⚠️ MkDir raises when the directory exists -- 'MkDir failed: cannot create'
/// -- and there is no built-in that asks whether one does. The build runs more
/// than once against the same tree, so the second run would fail on what the
/// first run made, and catching is the only way to say "either way".
procedure EnsureDir (Name : String);
begin
    try
        MkDir(Name);
    except on X : String do
        // Already there, which is the ordinary case from the second build on.
        // A handler needs a statement, and this is the smallest honest one.
        X := X;
    end
end

/// Fills the parts every page shares.
function Shared (Page : String) : String;
begin
    Page := Replace(Page, '{{BOOT}}',     ReadFile(Boot));
    Page := Replace(Page, '{{STYLE}}',    ReadFile(Style));
    Page := Replace(Page, '{{MASTHEAD}}', ReadFile(Mast));
    Page := Replace(Page, '{{THEME}}',    ReadFile(Theme));
    Page := Replace(Page, '{{SOURCE}}',   Repo);
    Page := Replace(Page, '{{RULES}}',    Rules);

    Exit Page;
end

/// Renders the specification into the reference page.
procedure RenderReference ();
var
    Lines := List();
    Words := Map();
    Page  := '';

begin
    EnsureDir(RefDir);

    Lines := ReadLines(Spec);
    Words := Keywords(ReadLines(Scanner));

    Page := Shared(ReadFile(Reference));
    Page := Replace(Page, '{{TOC}}',  Contents(Lines));
    Page := Replace(Page, '{{BODY}}', RenderWith(Lines, Words));

    WriteFile(RefInto, Page);

    WriteLn('  ' + RefInto);
end

/// Renders one template into one output file.
procedure RenderPage (From : String, Into : String);
var
    Page : String;

begin
    Page := ReadFile(From);

    Page := Shared(Page);

    Page := Replace(Page, '{{RELEASE}}', Release);
    Page := Replace(Page, '{{STATUS}}',  Status);
    Page := Replace(Page, '{{TAP}}',     Tap);

    WriteFile(Into, Page);

    WriteLn('  ' + Into);
end

begin
    Rules := RuleCount();

    WriteLn('generating:');

    RenderPage('templates/index.html', 'site/index.html');
    RenderReference();

    WriteLn('done.');
end
